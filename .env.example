# Email Sensor Configuration
# Copia este archivo a .env y completa los valores

# ============================================
# GitHub Webhook Configuration
# ============================================
# Token personal de GitHub para webhook
# Crea en: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL para enviar webhooks
# Formato: https://api.github.com/repos/OWNER/REPO/dispatches
GITHUB_WEBHOOK_URL=https://api.github.com/repos/arivas-web/prueba-mailing-aduanas/dispatches

# ============================================
# HubSpot Configuration
# ============================================
# Clave API de HubSpot
# Obtén en: https://app.hubspot.com/personal-access-key
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Portal ID de HubSpot
# Obtén en: Settings → Account Defaults
HUBSPOT_PORTAL_ID=123456789

# Nombre de la plantilla en HubSpot
HUBSPOT_TEMPLATE_NAME=Visual Trans 2026

# ============================================
# Google Drive Configuration
# ============================================
# ID de carpeta para guardar adjuntos
# Formato: https://drive.google.com/drive/folders/FOLDER_ID
DRIVE_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567

# ============================================
# Notificaciones
# ============================================
# Email para notificaciones de error
ADMIN_EMAIL=arivas@visualms.com

# ============================================
# Debug
# ============================================
# Habilitar logs detallados
DEBUG=false

# Modo de testing
TEST_MODE=false
